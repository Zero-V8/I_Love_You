PORT=4000

# Option A (recommended local): set absolute path to service account JSON
GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/to/love-4b827-firebase-adminsdk.json

# Option B (for deployments): provide these 3 variables instead of file path
FIREBASE_PROJECT_ID=love-4b827
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@love-4b827.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
